<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.coder-jeffery</groupId>
        <artifactId>distributed-lock</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>distributed-lock-spring-boot-starter</artifactId>
    <name>Distributed Lock Spring Boot Starter</name>
    <description>Starter that pulls in Redis and AOP for distributed locks.</description>
    <url>https://github.com/coder-jeffery/distributed-lock-starter</url>

    <dependencies>
        <dependency>
            <groupId>io.github.coder-jeffery</groupId>
            <artifactId>distributed-lock-spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>io.github.coderjeffery.distributedlock.starter</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
